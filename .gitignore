.env
# Cualquier variante: .env.prueba, .env.local, .env.produccion... Todas
# llevan secretos en claro. La regla anterior solo cubría .env y .env.backup*,
# así que un .env.prueba creado para un banco de pruebas era commiteable —
# y con él, la clave y el secreto de LiveKit.
.env.*
!.env.example
api/data/
uploads/
# Copias que deja scripts/optimizar-uploads.sh antes de recomprimir.
uploads.respaldo-*/
dist-releases/

# Herramientas locales, no se versionan
CLAUDE.md
.claude/
