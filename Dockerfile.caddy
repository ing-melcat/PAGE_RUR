# Build custom de Caddy con el bouncer de CrowdSec integrado: bloquea en el
# gateway, antes de que la petición llegue a cualquier servicio, cualquier
# IP que CrowdSec ya haya marcado (fuerza bruta, scanners, etc). El
# caddy:latest oficial no trae este módulo -- hay que compilarlo con xcaddy.
FROM caddy:2-builder AS builder
RUN xcaddy build --with github.com/hslatman/caddy-crowdsec-bouncer/http

FROM caddy:latest
COPY --from=builder /usr/bin/caddy /usr/bin/caddy
