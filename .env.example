# Copiar a .env y rellenar con valores reales generados, p.ej.:
#   openssl rand -base64 32
# Nunca hardcodear estos valores en docker-compose.yml ni en el código.
# .env ya está en .gitignore — no debe commitearse.

# --- Sesión / auth ---
JWT_SECRET=

# --- Postgres ---
POSTGRES_DB=rur
POSTGRES_SUPERUSER_PASSWORD=
IDENTITY_DB_PASSWORD=
CONTENT_DB_PASSWORD=
ROBOTS_DB_PASSWORD=

# --- svc-robots ---
# Clave de cifrado (AES-256-GCM) para livekit_api_secret en la tabla robots.
# Nunca se guarda en la base de datos, solo en el entorno del servicio.
ROBOTS_SECRET_KEY=

# --- CrowdSec ---
# Usada por svc-robots para leer /v1/decisions/stream de la LAPI de CrowdSec.
CROWDSEC_API_KEY=
# Usada por el bouncer embebido en el build custom de Caddy (fase 6).
CROWDSEC_BOUNCER_API_KEY=

# --- CORS ---
CORS_ORIGIN=https://rur.unipolidgo.edu.mx
