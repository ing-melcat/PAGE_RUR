<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Permitir que las peticiones a /login/ carguen los assets correctamente
  RewriteRule ^login/(.*)$ /$1 [L]

  RewriteRule ^index\.html$ - [L]
  # No reescribir si el archivo o directorio existe
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  # No reescribir si la petición va a la API
  RewriteCond %{REQUEST_URI} !^/api/
  # Enviar todo lo demás al index.html de React
  RewriteRule . /index.html [L]
</IfModule>
